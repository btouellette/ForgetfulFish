{
  "name": "forgetful-fish",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.7",
      "@humanfs/node": "^0.16.8",
      "baseline-browser-mapping": "^2.11.21",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "browserslist": "^4.28.8",
      "deepmerge-ts": "^8.0.2",
      "esbuild": "^0.28.2",
      "fast-uri": "^3.1.7",
      "fast-xml-parser": "^5.11.1",
      "flatted": "^3.4.4",
      "js-yaml@4": "^4.3.2",
      "lodash": "^4.18.1",
      "mysql2": "^3.24.3",
      "nanoid@3": "^3.3.18",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.7",
      "postcss": "^8.5.28",
      "undici": "^7.29.0",
      "vite": "^7.3.6"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "deploy:prod": "./scripts/deploy-prod.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:watch": "turbo run test:watch --parallel",
    "smoke:auth": "./scripts/auth-smoke.sh",
    "cards:sync-library": "node ./scripts/sync-card-image-library.mjs",
    "cards:download": "pnpm cards:sync-library",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "./scripts/format-changed.sh write",
    "format:check:changed": "./scripts/format-changed.sh check",
    "prepare": "[ -d .git ] && command -v git >/dev/null 2>&1 && simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm format:check:changed && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
